# Copy this file to .env.ps1 (same folder) and fill it in. .env.ps1 is never committed.
# start_prod.ps1 and scripts\backup_task.ps1 load it.

# Port the tunnel connects to (http://127.0.0.1:5050)
$env:SHADOW_PORT = '5050'

# 1 = the site is reached over HTTPS (tunnel): secure cookies and the HSTS header
$env:COOKIE_SECURE = '1'

# Header the tunnel puts the real client IP in.
# Tailscale Funnel: X-Forwarded-For    Cloudflare tunnel: CF-Connecting-IP
$env:SHADOW_CLIENT_IP_HEADER = 'X-Forwarded-For'

# Code people must type to create an account. Pick a long random one and share it privately.
# Leave it empty only for local development (registration is then open to anyone).
$env:SHADOW_ENROLL_CODE = 'change-me-to-a-long-random-code'

# Built dashboard (in F:\digital-shadow-dashboard run: npm run build)
$env:SHADOW_DASHBOARD_DIR = 'F:\digital-shadow-dashboard\dist'

# Days of daily summaries kept (minimum 14)
$env:SHADOW_RETENTION_DAYS = '90'

# Where scripts\backup.py writes shadow-YYYYmmdd-HHMM.db (14 newest are kept)
$env:SHADOW_BACKUP_DIR = 'F:\digital-shadow-backups'
